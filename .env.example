# Upstash Redis - https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://lenient-sheepdog-91652.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

# Also expose to the client (required for client-side Redis calls)
NEXT_PUBLIC_UPSTASH_REDIS_REST_URL=https://lenient-sheepdog-91652.upstash.io
NEXT_PUBLIC_UPSTASH_REDIS_REST_TOKEN=your-redis-rest-token

# Resend - https://resend.com
RESEND_API_KEY=your-resend-api-key

# Admin panel password
NEXT_PUBLIC_ADMIN_PASSWORD=your-secure-admin-password

# Full URL of your deployed site (no trailing slash)
NEXT_PUBLIC_APP_URL=https://cf-llc.github.io/emaillist
